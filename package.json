{
  "name": "giraboard",
  "private": true,
  "version": "1.0.0",
  "description": "Open-source task board that keeps small offices from forgetting things. Self-hosted, single Node.js process + SQLite.",
  "license": "MIT",
  "author": "vidzza",
  "homepage": "https://github.com/vidzza/giraboard#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vidzza/giraboard.git"
  },
  "bugs": {
    "url": "https://github.com/vidzza/giraboard/issues"
  },
  "keywords": [
    "kanban",
    "task-management",
    "todo",
    "small-business",
    "self-hosted",
    "sqlite",
    "hono",
    "react",
    "spanish"
  ],
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "probar": "npm run seed && npm run dev",
    "dev": "concurrently -k -n api,web -c cyan,magenta \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "node --disable-warning=ExperimentalWarning --watch --watch-path=server --watch-path=shared server/index.ts",
    "dev:web": "vite",
    "build": "vite build",
    "start": "NODE_ENV=production node --disable-warning=ExperimentalWarning server/index.ts",
    "seed": "node --disable-warning=ExperimentalWarning server/seed.ts",
    "admin": "node --disable-warning=ExperimentalWarning server/cli.ts",
    "backup": "node --disable-warning=ExperimentalWarning server/backup.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p web/tsconfig.json",
    "test": "node --disable-warning=ExperimentalWarning --test server/test/*.test.ts"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.4",
    "hono": "^4.13.13",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@fontsource-variable/figtree": "^5.3.0",
    "@fontsource-variable/fraunces": "^5.3.0",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-query": "^5.104.1",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.6",
    "date-fns": "^4.4.0",
    "lucide-react": "^1.54.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router": "^7.18.4",
    "sonner": "^2.0.8",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.4"
  }
}
